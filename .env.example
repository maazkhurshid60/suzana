# Which version of the site to build:
#   review   every copy-document flag shown inline
#   preview  clean version for showing the client (default): flags hidden, projects awaiting permission and
#            placeholder photos shown, hidden from search engines
#   public   the launch build: only approved content, no placeholders
NEXT_PUBLIC_SITE_MODE=preview

# Where contact form submissions are forwarded (JSON POST), e.g. a Formspree,
# Zapier or Make webhook. Without it, the form logs in development and fails in production.
CONTACT_WEBHOOK_URL=

# Public site URL, used for the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://garrectorassociates.com

# Dashboard (Sanity). Leave empty to run from the local content files in src/content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity publish webhook that refreshes the site (/api/revalidate/).
SANITY_REVALIDATE_SECRET=
